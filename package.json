{
  "name": "gym-app",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,mobile -c blue,green \"pnpm --filter @gym-app/api dev\" \"pnpm --filter @gym-app/mobile start\"",
    "dev:api": "pnpm --filter @gym-app/api dev",
    "dev:mobile": "pnpm --filter @gym-app/mobile start",
    "build": "pnpm --filter @gym-app/api build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @gym-app/api prisma:migrate",
    "db:seed": "pnpm --filter @gym-app/api db:seed",
    "db:studio": "pnpm --filter @gym-app/api prisma:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma", "unrs-resolver"]
  }
}
