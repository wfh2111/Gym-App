# Base URL of the apps/api server. Use your machine's LAN IP (not localhost) when testing on a
# physical device via Expo Go, e.g. http://192.168.1.23:4000
EXPO_PUBLIC_API_URL="http://localhost:4000"

# "sandbox" routes purchases through the dev-only billing endpoint instead of real RevenueCat/IAP
# (no App Store/Play Store products exist in this build). Switch to "live" for a real device build.
EXPO_PUBLIC_BILLING_MODE="sandbox"

EXPO_PUBLIC_REVENUECAT_IOS_KEY=""
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=""
