# --- Core ---
DATABASE_URL="postgresql://gymapp:gymapp@localhost:5432/gymapp?schema=public"
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string"

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_CHAT_MODEL="claude-opus-5"
ANTHROPIC_EXTRACTION_MODEL="claude-opus-5"

# --- Feature tuning ---
FREE_COACH_MESSAGES_PER_WEEK=10
ENABLE_CRON=false

# --- Wearable OAuth (leave blank to disable a provider) ---
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
WHOOP_REDIRECT_URI="http://localhost:4000/api/integrations/WHOOP/callback"

OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""
OURA_REDIRECT_URI="http://localhost:4000/api/integrations/OURA/callback"

GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
GARMIN_REDIRECT_URI="http://localhost:4000/api/integrations/GARMIN/callback"

# --- Billing (RevenueCat) ---
REVENUECAT_WEBHOOK_SECRET=""
REVENUECAT_PROJECT_API_KEY=""

# --- Nutrition lookup ---
OPENFOODFACTS_BASE_URL="https://world.openfoodfacts.org"
